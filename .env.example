# ============================================
# Secure Credentials Template
# ============================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# Use GitHub Repository Secrets for CI/CD workflows.
# ============================================

